MAIL_SERVER=your.server.explain
MAIL_PORT=your_port
MAIL_TLS=TRUE
MAIL_SSL=FALSE
USE_CREDENTIALS=TRUE
VALIDATE_CERTS=TRUE

OTP_LIVE_TIME_SECOND=600